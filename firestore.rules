rules_version = '2';

// Field lists and limits must match js/config/app-config.js and the *.model.js files.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity and roles ----------
    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasActiveProfile() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }
    function hasRole(roles) {
      return hasActiveProfile() && get(profilePath()).data.role in roles;
    }
    function canRead()  { return hasActiveProfile(); }
    function canEdit()  { return hasRole(['admin', 'editor']); }
    function isAdmin()  { return hasRole(['admin']); }

    // ---------- Helpers ----------
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function stamped(data) {
      return data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    // ---------- Users ----------
    function validUsername(name) {
      return name is string && name.matches('^[a-z0-9._-]{3,30}$');
    }
    // Phone: optional, digits, spaces and + - ( ) (PHONE_PATTERN in app-config.js).
    function validPhone(value) {
      return value is string && value.matches('^[0-9+() -]{0,20}$');
    }
    function usernameOwnedBy(name, uid) {
      return getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == uid;
    }
    function validPhoto(data, uid) {
      return (!('photoUrl' in data) || isText(data.photoUrl, 0, 2000))
        && (!('photoPath' in data) || data.photoPath == ''
            || (data.photoPath is string && data.photoPath.matches('profiles/' + uid + '/[^/]+')));
    }
    function validUser(data, uid) {
      return data.keys().hasOnly(['email', 'username', 'displayName', 'role', 'active', 'departmentId', 'phone', 'photoUrl', 'photoPath',
                                  'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt', 'updatedBy'])
        && isText(data.email, 3, 254)
        && (!('username' in data) || validUsername(data.username))
        && isText(data.displayName, 1, 80)
        && data.role in ['admin', 'editor', 'viewer']
        && data.active is bool
        && (!('departmentId' in data) || isText(data.departmentId, 0, 64))
        && (!('phone' in data) || validPhone(data.phone))
        && data.createdAt is timestamp
        && validPhoto(data, uid)
        && stamped(data);
    }
    // A user may edit only their own name, username, phone and photo — never role, active or department.
    // The email may only become the address Firebase Auth already has (sync after a verified change).
    function validSelfUpdate(uid) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return signedIn() && request.auth.uid == uid && hasActiveProfile()
        && changed.hasOnly(['displayName', 'username', 'phone', 'email', 'photoUrl', 'photoPath', 'updatedAt', 'updatedBy'])
        && isText(data.displayName, 1, 80)
        && (!('username' in changed) || (validUsername(data.username) && usernameOwnedBy(data.username, uid)))
        && (!('phone' in data) || validPhone(data.phone))
        && (!('email' in changed) || (isText(data.email, 3, 254) && data.email == request.auth.token.email))
        && validPhoto(data, uid)
        && stamped(data);
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isAdmin() && validUser(request.resource.data, uid)
        && 'username' in request.resource.data
        && usernameOwnedBy(request.resource.data.username, uid)
        && request.resource.data.createdAt == request.time;
      // Anyone: may edit their own profile fields (validSelfUpdate).
      // Admin: may change others' role/active/department (and their own department). An admin cannot demote or deactivate themselves.
      allow update: if validSelfUpdate(uid)
        || (isAdmin() && validUser(request.resource.data, uid)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.email == resource.data.email
            && request.resource.data.get('username', '') == resource.data.get('username', '')
            && !(uid == request.auth.uid
                 && (request.resource.data.role != 'admin' || request.resource.data.active != true)));
      allow delete: if false;
    }

    // ---------- Usernames (login lookup index) ----------
    // get is public so the login page can resolve username → email; list is denied (no enumeration).
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if validUsername(name)
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.keys().hasAll(['uid', 'email'])
        && isText(request.resource.data.email, 3, 254)
        && (isAdmin()
            || (hasActiveProfile()
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.email == request.auth.token.email));
      // Only the owner, keeping uid, to copy their new Auth email (after a verified email change).
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Assets ("Artículos") ----------
    // typeId ("Tipo de artículo"), availability, unavailableReason, notes and checkedAt are optional: articles
    // registered before they existed must still be editable. The app always writes typeId and availability.
    // brand, model, serialNumber (Marca, Modelo, Nro. de serie), builtIn (Empotrado) and insured (Asegurado)
    // are optional for the same reason, and so are proposedAction / proposedActionNote (inventory-taking).
    function validAsset(data) {
      return data.keys().hasOnly(['code', 'name', 'description', 'brand', 'model', 'serialNumber', 'builtIn', 'insured', 'typeId', 'categoryId', 'locationId', 'condition',
                                  'availability', 'unavailableReason', 'notes', 'proposedAction', 'proposedActionNote',
                                  'tags', 'acquisitionDate', 'value', 'quantity', 'photos', 'checkedAt',
                                  'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['code', 'name', 'description', 'categoryId', 'locationId', 'condition',
                               'tags', 'acquisitionDate', 'value', 'quantity', 'photos',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && isText(data.code, 0, 30)
        && isText(data.name, 1, 120)
        && isText(data.description, 0, 500)
        && (!('brand' in data) || isText(data.brand, 0, 60))
        && (!('model' in data) || isText(data.model, 0, 60))
        && (!('serialNumber' in data) || isText(data.serialNumber, 0, 60))
        && (!('builtIn' in data) || data.builtIn is bool)
        && (!('insured' in data) || data.insured is bool)
        && (!('typeId' in data) || isText(data.typeId, 1, 64))
        && isText(data.categoryId, 1, 64)
        && isText(data.locationId, 1, 64)
        && data.condition in ['new', 'good', 'fair', 'poor', 'out_of_service']
        && (!('availability' in data) || data.availability in ['available', 'in_use', 'loaned', 'in_repair', 'missing', 'unknown'])
        && (!('unavailableReason' in data) || isText(data.unavailableReason, 0, 200))
        && (!('notes' in data) || isText(data.notes, 0, 500))
        && (!('proposedAction' in data) || data.proposedAction in ['', 'dispose', 'repair', 'replace', 'donate', 'sell'])
        && (!('proposedActionNote' in data) || isText(data.proposedActionNote, 0, 200))
        && (!('checkedAt' in data) || data.checkedAt is timestamp)
        && data.tags is list && data.tags.size() <= 10
        && isText(data.acquisitionDate, 0, 10)
        && data.value is number && data.value >= 0 && data.value <= 1000000000
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 100000
        && data.photos is list && data.photos.size() <= 4
        && stamped(data);
    }

    match /assets/{assetId} {
      allow read: if canRead();
      allow create: if canEdit() && validAsset(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !('checkedAt' in request.resource.data);
      // checkedAt (inventory verification) may only stay as it was, become "now", or be removed (undo).
      allow update: if canEdit() && validAsset(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.get('checkedAt', null) == resource.data.get('checkedAt', null)
            || request.resource.data.get('checkedAt', null) == request.time
            || !('checkedAt' in request.resource.data));
      allow delete: if isAdmin();
    }

    // ---------- Change history of articles ("Historial") ----------
    // Immutable audit trail. An entry is accepted only inside the same batch as a real article write:
    // create/update/check/uncheck → the article's updatedAt after the batch is this request's time;
    // delete → the article no longer exists after the batch. Each change { field, from, to } is
    // validated by history.model.js (rules cannot loop over a list).
    function assetPath(assetId) {
      return /databases/$(database)/documents/assets/$(assetId);
    }
    function validHistory(data) {
      return data.keys().hasOnly(['assetId', 'assetName', 'action', 'changes', 'by', 'byName', 'at'])
        && data.keys().hasAll(['assetId', 'assetName', 'action', 'changes', 'by', 'byName', 'at'])
        && isText(data.assetId, 1, 64)
        && isText(data.assetName, 1, 120)
        && data.action in ['create', 'update', 'check', 'uncheck', 'delete']
        && data.changes is list && data.changes.size() <= 20
        && data.by == request.auth.uid
        && isText(data.byName, 1, 80)
        && data.at == request.time
        && ((data.action == 'delete' && !existsAfter(assetPath(data.assetId)))
            || (data.action != 'delete' && getAfter(assetPath(data.assetId)).data.updatedAt == request.time));
    }

    match /assetHistory/{entryId} {
      allow read: if canEdit();
      allow create: if canEdit() && validHistory(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- Catalogs ("Registros"; delete: admin only): locations and assetTypes = "Tipos de artículo" (validCatalog),
    //            categories = "Departamentos" (validDepartment) ----------
    function validCatalog(data) {
      return data.keys().hasOnly(['name', 'description', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['name', 'description', 'createdAt', 'updatedAt', 'updatedBy'])
        && isText(data.name, 1, 60)
        && isText(data.description, 0, 200)
        && stamped(data);
    }

    // Departments: same as a catalog plus the leader history [{ name, from, to }] (max 30 entries;
    // each entry is validated by catalog.model.js — rules cannot loop over a list).
    function validDepartment(data) {
      return data.keys().hasOnly(['name', 'description', 'leaders', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['name', 'description', 'leaders', 'createdAt', 'updatedAt', 'updatedBy'])
        && isText(data.name, 1, 60)
        && isText(data.description, 0, 200)
        && data.leaders is list && data.leaders.size() <= 30
        && stamped(data);
    }

    match /categories/{id} {
      allow read: if canRead();
      allow create: if canEdit() && validDepartment(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if canEdit() && validDepartment(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /assetTypes/{id} {
      allow read: if canRead();
      allow create: if canEdit() && validCatalog(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if canEdit() && validCatalog(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /locations/{id} {
      allow read: if canRead();
      allow create: if canEdit() && validCatalog(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if canEdit() && validCatalog(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ---------- Presence (connected users, read by the dashboard) ----------
    // Each user writes only their own heartbeat; lastSeen must be the server time of the write.
    function validPresence(uid) {
      let data = request.resource.data;
      return signedIn() && request.auth.uid == uid && hasActiveProfile()
        && data.keys().hasOnly(['displayName', 'lastSeen'])
        && data.keys().hasAll(['displayName', 'lastSeen'])
        && isText(data.displayName, 1, 80)
        && data.lastSeen == request.time;
    }

    match /presence/{uid} {
      allow read: if canEdit();
      allow create, update: if validPresence(uid);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
